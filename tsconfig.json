{
  "compilerOptions": {
    "target": "es2019",
    "module": "commonjs",
    "lib": ["es2019"],
    "types": ["node", "mocha"],
    "rootDir": "src",
    "outDir": "lib",
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src"]
}
